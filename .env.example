# sparkflock local config. Copy to .env (make init does this). Placeholders: set your own S3_SECRET_KEY / DB_PASSWORD in .env (git-ignored).
# Local = MinIO (S3 stand-in) + Postgres (RDS stand-in). For staging, see README.md.
S3_ENDPOINT=http://localhost:29000
S3_ACCESS_KEY=sparkflock
S3_SECRET_KEY=CHANGE_ME_min_8_chars
S3_BUCKET=sparkflock-ingest
S3_PREFIX=incoming/
DB_HOST=localhost
DB_PORT=25432
DB_NAME=sparkflock
DB_USER=sparkflock
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=prefer
# Spark tuning knobs (all read by spark/job.py)
MAX_PARTITION_MB=8
JDBC_PARTITIONS=4
MAX_FILES_PER_TRIGGER=100
TRIGGER_SECONDS=5
