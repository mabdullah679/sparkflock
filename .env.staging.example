# UNTESTED against real AWS (no credentials were available when this was built).
# Copy to .env.staging, fill from `terraform output`, then: ENV_FILE=.env.staging scripts/submit.sh local --mode once
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=sparkflock-ingest-CHANGEME-staging
S3_PREFIX=incoming/
DB_HOST=CHANGEME.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=sparkflock
DB_USER=sparkflock
DB_PASSWORD=CHANGEME-from-terraform-output
DB_SSLMODE=require
MAX_PARTITION_MB=128
JDBC_PARTITIONS=2
MAX_FILES_PER_TRIGGER=100
TRIGGER_SECONDS=10
