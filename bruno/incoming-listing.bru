meta {
  name: Files in incoming/
  type: http
  seq: 7
}

get {
  url: {{s3Url}}/{{bucket}}?list-type=2&prefix=incoming/
  body: none
  auth: awsv4
}

auth:awsv4 {
  accessKeyId: {{process.env.S3_ACCESS_KEY}}
  secretAccessKey: {{process.env.S3_SECRET_KEY}}
  sessionToken: 
  service: s3
  region: us-east-1
  profileName: 
}

docs {
  Lists what is sitting in the bucket's incoming/ folder. Proves the bucket
  exists and your credentials work. Files stay here after Spark reads them;
  this shows what was dropped, not what is still pending.
}

script:post-response {
  const m = String(res.getBody()).match(/<KeyCount>(\d+)<\/KeyCount>/);
  console.log("files under incoming/:", m ? m[1] : "unknown");
}

tests {
  test("bucket reachable with credentials", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
